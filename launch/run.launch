<launch>
  <arg name="use_sim_time" default="false" />
  <arg name="set_use_sim_time" default="false" />
  <arg name="ekf_config" default="$(find robot_loc)/params/loc_ekf.yaml" />
  <arg name="filtered_odom_topic" default="/localization/final_odom" />
  <arg name="input_queue_size" default="5" />
  <arg name="output_queue_size" default="5" />

  <param if="$(arg set_use_sim_time)" name="/use_sim_time" value="$(arg use_sim_time)" />

  <node pkg="robot_loc"
        type="yangpu_loc_ekf_node"
        name="yangpu_loc_ekf"
        output="log"
        clear_params="true">
    <!--
      先加载 loc_ekf.yaml 中的默认配置。
      如果后面再次使用 <param> 设置同名参数，后面的值会覆盖 YAML。
      因此排查实际参数时应使用 rosparam get，而不能只查看 YAML。
    -->
    <rosparam command="load" file="$(arg ekf_config)" />

    <param name="ins_odom_topic" value="/localization/ins" />
    <param name="fusion_odom_topic" value="/lio_loc_result" />
    <param name="localization_status_topic" value="/localization/status" />
    <param name="loc_policy_topic" value="/localization/loc_policy_code" />
    <param name="publish_filtered_odometry" value="false" />
    <param name="internal_periodic_update" value="false" />
    <param name="enable_set_pose_interface" value="false" />
    <!--
      当前 launch 显式覆盖 YAML 中的 predict_to_current_time。
      true 表示处理完最新 measurement 后，可继续将状态预测到本次输出 cycle_time。
      该模式要求速度状态可靠，并需要关注延迟观测和滤波器内部时间的一致性。
    -->
    <param name="predict_to_current_time" value="true" />
    <param name="input_queue_size" value="$(arg input_queue_size)" />
    <param name="output_queue_size" value="$(arg output_queue_size)" />

    <!--
      输出 pose 使用 map，输出 twist 按 base_link/车辆坐标系解释。
      自定义节点当前只重写 frame 标签，不执行完整 TF 坐标变换，
      因此上游数据必须满足对应的坐标系语义。
    -->
    <param name="frame_id" value="map" />
    <param name="child_frame_id" value="base_link" />

    <remap from="odometry/filtered" to="$(arg filtered_odom_topic)" />
  </node>
</launch>
